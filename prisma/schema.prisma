generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  email         String   @unique
  phone         String   @unique
  password      String
  role          String   @default("user")
  avatarUrl     String?  @map("avatar_url")
  emailVerified Boolean  @default(false) @map("email_verified")
  verifyToken   String?  @map("verify_token")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookings          Booking[]
  reviews           Review[]
  notifications     Notification[]
  favorites         UserVenueFavorite[]
  paymentMethods    UserPaymentMethod[]
  tickets           SupportTicket[]     @relation("TicketCreator")
  chatConversations ChatConversation[]
  chatMessages      ChatMessage[]
  ownerVenues       Venue[]

  @@map("users")
}

model Venue {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  description   String?
  address       String
  district      String?
  city          String?
  latitude      Float    @default(0)
  longitude     Float    @default(0)
  phone         String?
  status        String   @default("pending")
  ratingAverage Float    @default(0) @map("rating_average")
  ratingCount   Int      @default(0) @map("rating_count")
  bookingCount  Int      @default(0) @map("booking_count")
  favoriteCount Int      @default(0) @map("favorite_count")
  viewCount     Int      @default(0) @map("view_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  courts            Court[]
  bookingItems      BookingItem[]
  venueImages       VenueImages[]
  venueAmenities    VenueAmenities[]
  venueSports       VenueSport[]
  paymentAccounts   VenuePaymentAccount[]
  reviews           Review[]
  favorites         UserVenueFavorite[]
  operatingHours    OperatingHour[]
  chatConversations ChatConversation[]
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city, district])
  @@index([status])
  @@map("venues")
}

model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  courts      Court[]
  venueSports VenueSport[]
  proposals   SportProposal[]

  @@map("sports")
}

model SportProposal {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  sportName   String   @map("sport_name")
  status      String   @default("pending")
  slaDeadline DateTime @map("sla_deadline")
  sportId     String?  @map("sport_id")
  createdAt   DateTime @default(now()) @map("created_at")

  sport Sport? @relation(fields: [sportId], references: [id])

  @@map("sport_proposals")
}

model VenueSport {
  id          String   @id @default(uuid())
  venueId     String   @map("venue_id")
  sportId     String   @map("sport_id")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([venueId, sportId])
  @@map("venue_sports")
}

model Court {
  id                  String   @id @default(uuid())
  venueId             String   @map("venue_id")
  sportId             String   @map("sport_id")
  name                String
  description         String?
  basePriceVnd        Int      @map("base_price_vnd")
  minDurationMinutes  Int      @default(60) @map("min_duration_minutes")
  durationStepMinutes Int      @default(30) @map("duration_step_minutes")
  status              String   @default("active")
  maintenanceReason   String?  @map("maintenance_reason")
  bookingCount        Int      @default(0) @map("booking_count")
  viewCount           Int      @default(0) @map("view_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport        Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  courtImages  CourtImages[]
  priceRules   PriceRule[]
  blocks       CourtBlock[]
  bookingItems BookingItem[]

  @@index([venueId, sportId, status])
  @@map("courts")
}

model PriceRule {
  id        String   @id @default(uuid())
  courtId   String   @map("court_id")
  dayOfWeek Int[]    @map("day_of_week")
  timeFrom  String   @map("time_from")
  timeTo    String   @map("time_to")
  isPeak    Boolean  @default(false) @map("is_peak")
  priceVnd  Int      @map("price_vnd")
  createdAt DateTime @default(now()) @map("created_at")

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("price_rules")
}

model OperatingHour {
  id        String @id @default(uuid())
  venueId   String @map("venue_id")
  dayOfWeek Int    @map("day_of_week")
  openTime  String @map("open_time")
  closeTime String @map("close_time")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, dayOfWeek])
  @@map("operating_hours")
}

model CourtBlock {
  id        String   @id @default(uuid())
  courtId   String   @map("court_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startAt])
  @@map("court_blocks")
}

model Booking {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  bookingCode    String    @unique @map("booking_code")
  status         String    @default("waiting_payment")
  customerName   String?   @map("customer_name")
  customerPhone  String?   @map("customer_phone")
  totalAmount    Int       @map("total_amount")
  discountAmount Int       @default(0) @map("discount_amount")
  finalAmount    Int       @map("final_amount")
  note           String?
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    BookingItem[]
  payments Payment[]
  tickets  SupportTicket[]

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model BookingItem {
  id              String   @id @default(uuid())
  bookingId       String   @map("booking_id")
  courtId         String   @map("court_id")
  venueId         String   @map("venue_id")
  date            DateTime @db.Date
  startTime       DateTime @map("start_time") @db.Time(6)
  endTime         DateTime @map("end_time") @db.Time(6)
  durationMinutes Int      @map("duration_minutes")
  pricePerHour    Int      @map("price_per_hour")
  subtotal        Int
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court   Court   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([courtId, date])
  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id                    String    @id @default(uuid())
  bookingId             String    @map("booking_id")
  amount                Int
  gateway               String?   @default("vnpay")
  method                String    @default("vnpay")
  status                String    @default("pending")
  transactionCode       String?   @map("transaction_code")
  retryCount            Int       @default(0) @map("retry_count")
  paidAt                DateTime? @map("paid_at")
  venuePaymentAccountId String?   @map("venue_payment_account_id")
  gatewayResponse       Json?     @map("gateway_response")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  booking             Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venuePaymentAccount VenuePaymentAccount? @relation(fields: [venuePaymentAccountId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  accounts VenuePaymentAccount[]

  @@map("payment_methods")
}

model VenuePaymentAccount {
  id              String   @id @default(uuid())
  venueId         String   @map("venue_id")
  paymentMethodId String   @map("payment_method_id")
  provider        String?
  accountNumber   String?
  accountName     String?
  bankCode        String?
  bankName        String?
  qrCodeUrl       String?  @map("qr_code_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  venue         Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  payments      Payment[]

  @@unique([venueId, paymentMethodId])
  @@map("venue_payment_accounts")
}

model UserPaymentMethod {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String   @default("card")
  provider      String
  providerToken String?  @map("provider_token")
  maskedNumber  String?  @map("masked_number")
  holderName    String?  @map("holder_name")
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_payment_methods")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  venueId   String   @map("venue_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId])
  @@map("reviews")
}

model UserVenueFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  venueId   String   @map("venue_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId])
  @@map("user_venue_favorites")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    @default("system")
  title     String
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(uuid())
  creatorId   String   @map("creator_id")
  bookingId   String?  @map("booking_id")
  type        String
  description String
  status      String   @default("open")
  adminNote   String?  @map("admin_note")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator User     @relation("TicketCreator", fields: [creatorId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@map("support_tickets")
}

model Amenities {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venues VenueAmenities[]

  @@map("amenities")
}

model VenueAmenities {
  id        String   @id @default(uuid())
  venueId   String   @map("venue_id")
  amenityId String   @map("amenity_id")
  createdAt DateTime @default(now()) @map("created_at")

  venue   Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  amenity Amenities @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([venueId, amenityId])
  @@map("venue_amenities")
}

model VenueImages {
  id          String   @id @default(uuid())
  url         String
  venueId     String   @map("venue_id")
  isThumbnail Boolean  @default(false) @map("is_thumbnail")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_images")
}

model CourtImages {
  id          String   @id @default(uuid())
  url         String
  courtId     String   @map("court_id")
  isThumbnail Boolean  @default(false) @map("is_thumbnail")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_images")
}

model ChatConversation {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  venueId       String    @map("venue_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue    Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  module     String?
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fromValue  String?  @map("from_value")
  toValue    String?  @map("to_value")
  note       String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
